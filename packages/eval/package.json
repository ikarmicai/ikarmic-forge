{
  "name": "@ikarmic/forge-eval",
  "version": "5.1.1",
  "description": "Eval harness for IKarmic AI Forge. Runs agent tasks against isolated workspaces and grades the results with deterministic checks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "forge-eval": "./dist/bin/forge-eval.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "eval",
    "benchmark",
    "agent",
    "llm",
    "code-assistant",
    "testing"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikarmicai/ikarmic-forge"
  },
  "bugs": {
    "url": "https://github.com/ikarmicai/ikarmic-forge/issues"
  },
  "homepage": "https://github.com/ikarmicai/ikarmic-forge/tree/main/packages/eval#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin/forge-eval.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@ikarmic/forge-core": "^5.1.1",
    "ai": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
